&НаСервере
Процедура ЗаполнитьТаблицуНоменклатурыИШтрихкодов()
///// Выбираем номенклатуру
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Спр_Номенклатура.Ссылка КАК НоменклатураСсылка,
		|	Спр_Номенклатура.Код КАК Код,
		|	Спр_Номенклатура.Наименование КАК Наименование,
		|	Спр_Номенклатура.Артикул КАК Артикул,
		|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, """") КАК Штрихкод,
		|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка, """") КАК Упаковка,
		|	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение.Наименование, """") КАК ДопРеквизит,
		|	Спр_Номенклатура.ФайлКартинки КАК ФайлКартинки
		|ИЗ
		|	Справочник.Номенклатура КАК Спр_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ШтрихкодыНоменклатуры.Номенклатура = Спр_Номенклатура.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО Спр_Номенклатура.Ссылка = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство = &мДополнительныйРеквизит)
		|			
		|ГДЕ
		|	Спр_Номенклатура.ЭтоГруппа = ЛОЖЬ";
	Запрос.УстановитьПараметр("мДополнительныйРеквизит",мДополнительныйРеквизит);
	
	
	Если не мТипЗначенияДопРеквизита="ДополнительноеЗначение" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"НоменклатураДополнительныеРеквизиты.Значение.Наименование","НоменклатураДополнительныеРеквизиты.Значение");
	КонецЕсли;
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрокаТЧ = СпрНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ,ВыборкаДетальныеЗаписи);
		НоваяСтрокаТЧ.Код = СокрЛП(НоваяСтрокаТЧ.Код);
		
	КонецЦикла;
	
	
///// Выбираем штрихкода номенклатуры

//// Выбириаем номенклатуру  поставщиков
Если НеобходимоСоздатьНоменклатуруПоставщика Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПоставщиков.Ссылка КАК НоменклатураПоставщиковСсылка,
		|	НоменклатураПоставщиков.Код КАК Код,
		|	НоменклатураПоставщиков.Номенклатура КАК Наименование,
		|	НоменклатураПоставщиков.Артикул КАК Артикул,
		|	НоменклатураПоставщиков.Владелец КАК Владелец,
		|	НоменклатураПоставщиков.Номенклатура КАК Номенклатура
		|ИЗ
		|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
		|ГДЕ
		|	НоменклатураПоставщиков.ЭтоГруппа = ЛОЖЬ
		|	И НоменклатураПоставщиков.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец",Партнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СпрНоменклатураПоставщиков.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
КонецЕсли;	
	

//// Выбираем присоеднинённые файлы для номенкатуры
Если ЗагружаемИзображения Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПрисоединенныеФайлы.Ссылка КАК СсылкаНаКартинку,
		|	НоменклатураПрисоединенныеФайлы.Наименование КАК Наименование,
		|	НоменклатураПрисоединенныеФайлы.ВладелецФайла КАК ВладелецФайла,
		|	НоменклатураПрисоединенныеФайлы.Размер КАК Размер,
		|	НоменклатураПрисоединенныеФайлы.Расширение КАК Расширение
		|ИЗ
		|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
		|ГДЕ
		|	НоменклатураПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СпрПрисоединённыеФайлы.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
КонецЕсли;	

//// Выбираем группы номенкатуры
Если РазнестиНоменклатуруПоГруппамУказаннымВДанныхДляЗагрузки Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Группа,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СпрГруппыНоменклатуры.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
КонецЕсли;	





КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопРеквизит(НоменклатураСсылка,ВыбрДополнительныйРеквизит,ЗначениеДопРеквизита)
	Если мТипЗначенияДопРеквизита="ДополнительноеЗначение" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
			|	ЗначенияСвойствОбъектов.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
			|ГДЕ
			|	ЗначенияСвойствОбъектов.Владелец = &Владелец
			|	И ЗначенияСвойствОбъектов.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Владелец", ВыбрДополнительныйРеквизит);
		Запрос.УстановитьПараметр("Наименование", ЗначениеДопРеквизита);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если  РезультатЗапроса.Количество()=0 Тогда
			НовыйЭлемент = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			НовыйЭлемент.Наименование = ЗначениеДопРеквизита;
			НовыйЭлемент.Владелец = ВыбрДополнительныйРеквизит;
			НовыйЭлемент.Записать();
			ВыбрЗначение = НовыйЭлемент.Ссылка;
		Иначе
			ВыбрЗначение = РезультатЗапроса[0].Ссылка; 
		КонецЕсли;
	Иначе
		Если мТипЗначенияДопРеквизита="Дата" Тогда
			Попытка
				ПромСтрокаСДатой = СтрЗаменить(ЗначениеДопРеквизита,".","");
				ВыбрЗначение = Дата(Прав(ПромСтрокаСДатой,4),Сред(ПромСтрокаСДатой,3,2),Лев(ПромСтрокаСДатой,2));
			Исключение
			    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры  "+Строка(НоменклатураСсылка)+"  не удвлось прочитать значение дополнительного реквизита "+ЗначениеДопРеквизита);
				Возврат;
			КонецПопытки;
		ИначеЕсли мТипЗначенияДопРеквизита="Число" Тогда 
			Попытка
				ВыбрЗначение = Число(ЗначениеДопРеквизита);
			Исключение
			    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры  "+Строка(НоменклатураСсылка)+"  не удвлось прочитать значение дополнительного реквизита "+ЗначениеДопРеквизита);
				Возврат;
			КонецПопытки;
		ИначеЕсли мТипЗначенияДопРеквизита="Булево" Тогда 
			Если  Врег(ЗначениеДопРеквизита)="ИСТИНА" или Врег(ЗначениеДопРеквизита)="ДА" или Врег(ЗначениеДопРеквизита)="TRUE" Тогда
				ВыбрЗначение = Истина;
			КонецЕсли;
			
			Если  Врег(ЗначениеДопРеквизита)="ЛОЖЬ" или Врег(ЗначениеДопРеквизита)="НЕТ" или Врег(ЗначениеДопРеквизита)="FALSE" Тогда
				ВыбрЗначение = Ложь;
			КонецЕсли;
			
		ИначеЕсли мТипЗначенияДопРеквизита="Строка" Тогда 
			ВыбрЗначение = ЗначениеДопРеквизита;
		Иначе
			ВыбрЗначение =Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	//Возврат;
	Если ЗначениеЗаполнено(ВыбрЗначение) Тогда
		 СтруктураОтбора = Новый Структура("Свойство, Значение",ВыбрДополнительныйРеквизит,ВыбрЗначение);
		 НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект();
		 //НоменклатураОбъект.ДополнительныеРеквизиты.Очистить();
		 НайденныеСтроки = НоменклатураОбъект.ДополнительныеРеквизиты.НайтиСтроки(СтруктураОтбора);
		 
		 Если НайденныеСтроки.Количество()=0 Тогда
			 НоваяСтрокаДопРеквизитов = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
		 Иначе
			 //НоваяСтрокаДопРеквизитов = НайденныеСтроки[0];
			 //Если НайденныеСтроки.Количество()>1 Тогда
			 Для каждого ВыбрСтрока из НайденныеСтроки Цикл
				 НоменклатураОбъект.ДополнительныеРеквизиты.Удалить(ВыбрСтрока);
				 
			 КонецЦикла;
			 НоваяСтрокаДопРеквизитов = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
			 //    
			 //    
			 //КонецЕсли;
			 
		 КонецЕсли;
		 НоваяСтрокаДопРеквизитов.Свойство = ВыбрДополнительныйРеквизит;
		 НоваяСтрокаДопРеквизитов.Значение = ВыбрЗначение;
		 НоменклатураОбъект.Записать();
		 
	КонецЕсли;
	
		
	
	
КонецПроцедуры

#КонецОбласти

