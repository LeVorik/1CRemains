					НоваяСтрокаНом.Номенклатура = РедОбъект.Ссылка;
					//Если НоваяСтрока.НоваяНоменклатура Тогда
						НоваяСтрокаНом.НоваяНоменклатура = НоваяСтрока.НоваяНоменклатура;
					//Иначе
						НоваяСтрокаНом.ОтредактированнаяНоменклатура = не НоваяСтрока.НоваяНоменклатура;
					//КонецЕсли;
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("!! В загружаемых данных есть задвоение артикула "+НоваяСтрока.Артикул );
				 КонецЕсли;
			Исключение
				НомерСтроки = НомерСтроки + 1;
				СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + НоваяСтрока.Наименование);

				Продолжить;
				
			КонецПопытки;
			НоваяСтрока.НоменклатураСсылка = РедОбъект.Ссылка;	
			
			
			
			
			Если НоваяСтрока.НоваяНоменклатура или не ЗначениеЗаполнено(НоваяСтрока.НоменклатураСсылка.ЕдиницаИзмерения) Тогда
				СоздаемЕдиницуИзмеренияДляНоменклатуры(НоваяСтрока);
			КонецЕсли;
			Если НеобходимоСоздатьНоменклатуруПоставщика Тогда
				СозданиеНоменклатурыПоставщика(НоваяСтрока,НоваяСтрокаНом,НомерСтроки);
			КонецЕсли;

			Если ЗначениеЗаполнено(НоваяСтрока.Штрихкод) Тогда       //// если указан в загрузке ШК
			НетШК = КонтрольНаличияШтрихкодаУДругихНоменклатур(НоваяСтрока.Штрихкод,НоваяСтрока.НоменклатураСсылка);
			
			
				Если НетШК  Тогда /// и он не пренадлежит другой номенклатуре, то регистрируем его
						НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей(); 
						НаборЗаписей.Отбор.Штрихкод.Установить(НоваяСтрока.Штрихкод); 
						
							НоваяЗапись = НаборЗаписей.Добавить(); 
							НоваяЗапись.Штрихкод   		= НоваяСтрока.Штрихкод;
							НоваяЗапись.Номенклатура 	= НоваяСтрока.НоменклатураСсылка;
							НоваяЗапись.Характеристика	= Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
							НоваяЗапись.Упаковка		= НоваяСтрока.НоменклатураСсылка.ЕдиницаИзмерения;
						
						НаборЗаписей.Записать(Истина); 
				КонецЕсли;
			КонецЕсли;
			Если ЗаполняемДопРеквизит Тогда
				Если ЗначениеЗаполнено(НоваяСтрока.ЗначениеДопРеквизита) Тогда       //// если заполнено доп свойство
					  ЗаполнитьДопРеквизит(НоваяСтрока.НоменклатураСсылка,мДополнительныйРеквизит,НоваяСтрока.ЗначениеДопРеквизита);
				КонецЕсли;
			КонецЕсли;
			Если ЗагружаемИзображения и СокрЛП(НоваяСтрока.Артикул)<>"" Тогда
				 ЗагрузкаИзображения(НоваяСтрока);
			КонецЕсли;
			
			Если НоваяСтрока.НоваяНоменклатура Тогда
				ДобавитьНоменклатуруВСпрНоменклатура(НоваяСтрока.НоменклатураСсылка);
			КонецЕсли;
			
			
			Если ЗагружатьВесогабаритныеРазмеры Тогда
				
				МассивСтруктур = Новый Массив;
				Если не ДополнительныйРеквизитВес.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитВес,НоваяСтрока.Вес));
				КонецЕсли;
				Если не ДополнительныйРеквизитВысота.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитВысота,НоваяСтрока.Высота));
				КонецЕсли;
				
				Если не ДополнительныйРеквизитДлина.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитДлина,НоваяСтрока.Длина));
				КонецЕсли;
				Если не ДополнительныйРеквизитОбъем.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитОбъем,НоваяСтрока.Объем));
				КонецЕсли;
				Если не ДополнительныйРеквизитПлощадь.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитПлощадь,НоваяСтрока.Площадь));
				КонецЕсли;
				Если не ДополнительныйРеквизитШирина.Пустая() Тогда
					МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ДополнительныйРеквизитШирина,НоваяСтрока.Ширина));
				КонецЕсли;
				УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(НоваяСтрока.НоменклатураСсылка,МассивСтруктур);				
	
				
			КонецЕсли;
			
			
		НомерСтроки = НомерСтроки + 1;
		СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
		
		Попытка
			ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст)
			//ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст)
				Или ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаНаименование")).Текст)
				Или ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаЗначениеДопРеквизита")).Текст)
				Или ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаШтрихкод")).Текст)
				Или ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		//Прервать;
	КонецЦикла;
	СпрНоменклатура.Очистить();
	СпрНоменклатураПоставщиков.Очистить();

	ТаблицаЗагружаемыхДанных.Очистить();
	СпрПрисоединённыеФайлы.Очистить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст, ПутьКДанным = "")
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.ПутьКДанным = ПутьКДанным;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ОпределитьТипЗначения(смДополнительныйРеквизит)
	
	смТипЗначенияДопРеквизита = Неопределено;
	
	Если Строка(мДополнительныйРеквизит.ТипЗначения)  = "Строка" Тогда
		смТипЗначенияДопРеквизита = "Строка";
	ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Число" Тогда
		смТипЗначенияДопРеквизита = "Число";
	ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Булево" Тогда
		смТипЗначенияДопРеквизита = "Булево";
	ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения) = "Дополнительное значение"  Тогда
		смТипЗначенияДопРеквизита = "ДополнительноеЗначение";
	ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Дата" Тогда
		смТипЗначенияДопРеквизита = "Дата";
	//ИначеЕсли Найти(Строка(мДополнительныйРеквизит.ТипЗначения)  = "Дата" Тогда
		//мТипЗначенияДопРеквизита = "Дата";
	Иначе
		смТипЗначенияДопРеквизита = Неопределено;
	КонецЕсли;
	
	Возврат смТипЗначенияДопРеквизита;
	
КонецФункции

