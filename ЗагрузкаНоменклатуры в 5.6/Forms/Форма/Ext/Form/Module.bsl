&НаСервере
Функция НайтиГруппуТоваров(ГруппаНаименование)
	Если ГруппаНаименование="" или ГруппаНаименование=Неопределено Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Структура = Новый Структура("Наименование",ГруппаНаименование);
	НайденныеСтроки = СпрГруппыНоменклатуры.НайтиСтроки(Структура);
	
	Если НайденныеСтроки.Количество()>0 Тогда
		НайденнаяГруппа = НайденныеСтроки[0].Группа; 
	Иначе
		Если СоздаватьНенайденныеГруппы Тогда
			НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
			НоваяГруппа.Наименование = ГруппаНаименование;
			
			Если не ВыбрГруппаДляЗагрузки.Пустая() Тогда
				НоваяГруппа.Родитель = ВыбрГруппаДляЗагрузки;
			КонецЕсли;
			
			НоваяГруппа.Записать();
			
			НайденнаяГруппа = НоваяГруппа.Ссылка;
			
			НоваяСтрокаГрупп = СпрГруппыНоменклатуры.Добавить();
			
			НоваяСтрокаГрупп.Группа = НоваяГруппа.Ссылка;
			НоваяСтрокаГрупп.Наименование = ГруппаНаименование;
		Иначе
			НайденнаяГруппа = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
		
	
	КонецЕсли;
	
	Возврат НайденнаяГруппа;
	
		
КонецФункции

&НаСервере
Процедура СозданиеНоменклатурыПоставщика(НоваяСтрока,НоваяСтрокаНом,НомерСтроки)
	
			НайденнаяНоменклатураПоставщика= Неопределено; 
			НоваяНоменклатураПоставщика = Ложь;
			
			Если НеобходимоСоздатьНоменклатуруПоставщика Тогда
				Если ПропускатьСозданиеНоменклатурыПоставщикаСПустымиНаименованием и  СокрЛП(НоваяСтрока.НаименованиеНоменклатурыПоставщика)="" Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для товара не заполнено наименование поставщика "+Строка(НоваяСтрока.НоменклатураСсылка)+", Отмена, создание номенклатуры поставщику, для данной номенклатуры ");
					Возврат;
				КонецЕсли;
				Если НоваяСтрока.Артикул="" Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для товара " +Строка(НоваяСтрока.НоменклатураСсылка)+ "не указан  артикул в данных для загрузки.  Создать номенклатуру поставщика, для данной номенклатуры невозможно");
					Возврат; 
				КонецЕсли;
				СтруктураПоиска = Новый Структура("Артикул,Номенклатура",НоваяСтрока.Артикул,НоваяСтрока.НоменклатураСсылка);
				НайденныеСтрокиНомПост = СпрНоменклатураПоставщиков.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтрокиНомПост.Количество()=0 ТОгда
					НайденнаяНоменклатураПоставщика =  Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
					НоваяНоменклатураПоставщика 	= Истина;
				Иначе
					Если ЧтоДелаемСНайденнойНоменклатуройПоставщика=1 Тогда
						НоваяСтрокаНом.НоменклатураПоставщика = НайденныеСтрокиНомПост[0].НоменклатураПоставщиковСсылка;

						НайденнаяНоменклатураПоставщика = Неопределено;
					Иначе
						НайденнаяНоменклатураПоставщика = НайденныеСтрокиНомПост[0].НоменклатураПоставщиковСсылка.ПолучитьОбъект();
					КонецЕсли;
				КонецЕсли;
				
				
			КонецЕсли;
			
			Если НайденнаяНоменклатураПоставщика= Неопределено Тогда 
				//НомерСтроки = НомерСтроки + 1;
				//СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
				//
				Возврат 
			КонецЕсли;
			
			
			ЗаполнитьЗначенияСвойств(НайденнаяНоменклатураПоставщика,НоваяСтрокаНом.Номенклатура);
			НайденнаяНоменклатураПоставщика.Владелец		= Партнер;
			НайденнаяНоменклатураПоставщика.Номенклатура	= НоваяСтрокаНом.Номенклатура;
			НайденнаяНоменклатураПоставщика.Родитель		= ГруппаЗагрузкиНоменклатурыПоставщиков;
			НайденнаяНоменклатураПоставщика.Наименование	= НоваяСтрока.НаименованиеНоменклатурыПоставщика;
			НайденнаяНоменклатураПоставщика.Код 			= "";

			
			Попытка
				
			
				Если НайденнаяНоменклатураПоставщика.ЭтоНовый()
					И Не ЗначениеЗаполнено(НайденнаяНоменклатураПоставщика.Код) Тогда
						НайденнаяНоменклатураПоставщика.УстановитьНовыйКод();
				КонецЕсли;
				
				НайденнаяНоменклатураПоставщика.Записать();
				НоваяСтрокаНом.НоменклатураПоставщика = НайденнаяНоменклатураПоставщика.Ссылка;
				
				Если НоваяНоменклатураПоставщика Тогда
					НоваяСтрокаСпрНоменклатураПоставщиков = СпрНоменклатураПоставщиков.Добавить();
					НоваяСтрокаСпрНоменклатураПоставщиков.НоменклатураПоставщиковСсылка = НайденнаяНоменклатураПоставщика.Ссылка;
					НоваяСтрокаСпрНоменклатураПоставщиков.Владелец						= Партнер;
					НоваяСтрокаСпрНоменклатураПоставщиков.Код							= "";
					НоваяСтрокаСпрНоменклатураПоставщиков.Артикул						= НайденнаяНоменклатураПоставщика.Артикул;
					//НоваяСтрокаСпрНоменклатураПоставщиков.Наименование					= "";
					НоваяСтрокаСпрНоменклатураПоставщиков.Наименование					= НайденнаяНоменклатураПоставщика.Наименование;
					НоваяСтрокаСпрНоменклатураПоставщиков.Номенклатура					= НайденнаяНоменклатураПоставщика.Номенклатура;
				КонецЕсли;
				
				
			Исключение
				//НомерСтроки = НомерСтроки + 1;
				//СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Возврат;
			КонецПопытки;
	
	
	
КонецПроцедуры

&НаСервере
Функция КонтрольНаличияШтрихкодаУДругихНоменклатур(Штрихкод,Номенклатура)
	
	СтруктураПоиска = Новый Структура("Штрихкод",Штрихкод);
	НайденныеСтроки = СпрНоменклатура.НайтиСтроки(СтруктураПоиска);
	НетШтрихкода = Истина; 
	Если НайденныеСтроки.Количество()=0 Тогда НетШтрихкода = Истина; 
	Иначе
		Если НайденныеСтроки[0].НоменклатураСсылка<>Номенклатура Тогда
			 НетШтрихкода = Ложь;
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Попытка присвоить штрихкод "+Штрихкод+"  номенклатуре "+Строка(Номенклатура)+" принадлежит другой номенклатуре" + Строка(НайденныеСтроки[0].НоменклатураСсылка)  +", присвоение штрихкода пропускаем");
		КонецЕсли;
		 
		
		
		
	КонецЕсли;

	Возврат НетШтрихкода;
	
КонецФункции

&НаСервере
Процедура ДобавитьНоменклатуруВСпрНоменклатура(ВыбрНоменклатура)
	
	Если ВыбрНоменклатура=Неопределено Тогда Возврат; КонецЕсли;
///// Выбираем номенклатуру
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Спр_Номенклатура.Ссылка КАК НоменклатураСсылка,
		|	Спр_Номенклатура.Код КАК Код,
		|	Спр_Номенклатура.Наименование КАК Наименование,
		|	Спр_Номенклатура.Артикул КАК Артикул,
		|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, """") КАК Штрихкод,
		|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Упаковка, """") КАК Упаковка,
		|	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение.Наименование, """") КАК ДопРеквизит,
		|	Спр_Номенклатура.ФайлКартинки КАК ФайлКартинки
		|ИЗ
		|	Справочник.Номенклатура КАК Спр_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО (ШтрихкодыНоменклатуры.Номенклатура = Спр_Номенклатура.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО Спр_Номенклатура.Ссылка = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство = &мДополнительныйРеквизит)
		|ГДЕ
		|	Спр_Номенклатура.ЭтоГруппа = ЛОЖЬ
		|	И Спр_Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("мДополнительныйРеквизит",мДополнительныйРеквизит);
	Запрос.УстановитьПараметр("Ссылка",ВыбрНоменклатура);
	
	
	Если не мТипЗначенияДопРеквизита="ДополнительноеЗначение" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"НоменклатураДополнительныеРеквизиты.Значение.Наименование","НоменклатураДополнительныеРеквизиты.Значение");
	КонецЕсли;
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("НоменклатураСсылка",ВыборкаДетальныеЗаписи.НоменклатураСсылка);
		НайденныеСтроки = СпрНоменклатура.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество()=0 Тогда
			НоваяСтрокаТЧ = СпрНоменклатура.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ,ВыборкаДетальныеЗаписи);
			НоваяСтрокаТЧ.Код = СокрЛП(НоваяСтрокаТЧ.Код);
		КонецЕсли;
	КонецЦикла;
	
	
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСФайломИзображения

&НаСервере
Процедура ЗагрузкаИзображения(НоваяСтрока)
	Если СокрЛП(ПутьККаталогуИзображений)="" или СокрЛП(НоваяСтрока.Артикул)="" Тогда Возврат; КонецЕсли;
	ЧастьИмениФайла = СокрЛП(НоваяСтрока.Артикул);
	Файлы = НайтиФайлы(ПутьККаталогуИзображений,ЧастьИмениФайла+".*",Истина);
	Если Файлы.Количество()=0 Тогда Возврат; КонецЕсли;
	СтрокаДанныхПоФайлу 	= Файлы[0];
	ИмяФайлаБезРасширения 	= СтрокаДанныхПоФайлу.ИмяБезРасширения;
	ИмяФайлаСРасширением 	= СтрокаДанныхПоФайлу.Имя;
	ПолныйПутьККартинке     = СтрокаДанныхПоФайлу.ПолноеИмя;
	ПоискФайлаВБазе 		= ПоискИзображения(ИмяФайлаБезРасширения, НоваяСтрока.НоменклатураСсылка);
	
	Если ПоискФайлаВБазе=Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка() Тогда
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ПолныйПутьККартинке);
		АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		ПараметрыФайла = Новый Структура();
		ПараметрыФайла.Вставить("ВладелецФайлов",НоваяСтрока.НоменклатураСсылка);
		ПараметрыФайла.Вставить("ИмяБезРасширения",СтрокаДанныхПоФайлу.ИмяБезРасширения);
		ПараметрыФайла.Вставить("РасширениеБезТочки",СтрЗаменить(СтрокаДанныхПоФайлу.Расширение,".",""));
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное",ТекущаяДата());
		ПараметрыФайла.Вставить("Автор",ПользователиКлиентСервер.ТекущийПользователь());
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла,
															  АдресВременногоХранилищаФайла,
															  "",
															  "",
															  Неопределено);		
				
		Если ЗагружаемуюКартинкуСделатьОсновной И ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
			РедОбъект  				= НоваяСтрока.НоменклатураСсылка.ПолучитьОбъект();
			РедОбъект.ФайлКартинки  = ПрисоединенныйФайл.Ссылка; 
			РедОбъект.Записать();
		Иначе
			Сообщить("Не удалось добавить в базу файл "+ПолныйПутьККартинке);
		КонецЕсли;

	Иначе
		Если ЗагружаемуюКартинкуСделатьОсновной и НоваяСтрока.НоменклатураСсылка.ФайлКартинки  <> ПоискФайлаВБазе.СсылкаНаКартинку Тогда
			РедОбъект  				= НоваяСтрока.НоменклатураСсылка.ПолучитьОбъект();
			РедОбъект.ФайлКартинки  = ПоискФайлаВБазе.СсылкаНаКартинку; 
			РедОбъект.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПоискИзображения(ИмяФайла, ВладелецФайла)
	
СтруктураОтбора = Новый Структура("Наименование,ВладелецФайла",ИмяФайла,ВладелецФайла);

НайденныеСтроки = СпрПрисоединённыеФайлы.НайтиСтроки(СтруктураОтбора);
Если НайденныеСтроки.Количество()=0 Тогда
	 НайденнаяПозиция = Справочники.НоменклатураПрисоединенныеФайлы.ПустаяСсылка();
 Иначе
	 НайденнаяПозиция = НайденныеСтроки[0];
КонецЕсли;
Возврат НайденнаяПозиция;
	
	
КонецФункции

