#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура Загрузить(Команда)
	Если ВариантПоискаНоменклатуры=0 Тогда	           //// по коду
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R2C1").Текст);
	//	Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
	//		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла. наименование должно быть заполнено обязательно'"));
	//		Возврат;
	//	КонецЕсли;
	ИначеЕсли ВариантПоискаНоменклатуры=1 Тогда	             //// по артикулу
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R2C2").Текст);
		Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла. артикул должен быть заполнен обязательно'"));
			Возврат;
		КонецЕсли;
	ИначеЕсли ВариантПоискаНоменклатуры=2 Тогда	           //// по штрихкоду
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R2C3").Текст);
		Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла. штрихкод должен быть заполнен обязательно'"));
			Возврат;
		КонецЕсли;
	ИначеЕсли ВариантПоискаНоменклатуры=3 Тогда	             //// по наименованию
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R2C4").Текст);
		Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла. наименование должно быть заполнено обязательно'"));
			Возврат;
		КонецЕсли;
	ИначеЕсли ВариантПоискаНоменклатуры=4 Тогда	             //// по дополнительному реквизиту
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R2C8").Текст);
		Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла. значение дополнительного реквизита должно быть заполнено обязательно'"));
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	Если не мДополнительныйРеквизит.Пустая()		Тогда
		ЗаполняемДопРеквизит=Истина;
	КонецЕсли;
	
	мТипЗначенияДопРеквизита = ОпределитьТипЗначения(мДополнительныйРеквизит);
	//Если Строка(мДополнительныйРеквизит.ТипЗначения)  = "Строка" Тогда
	//	мТипЗначенияДопРеквизита = "Строка";
	//ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Число" Тогда
	//	мТипЗначенияДопРеквизита = "Число";
	//ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Булево" Тогда
	//	мТипЗначенияДопРеквизита = "Булево";
	//ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения) = "Дополнительное значение"  Тогда
	//	мТипЗначенияДопРеквизита = "ДополнительноеЗначение";
	//ИначеЕсли Строка(мДополнительныйРеквизит.ТипЗначения)  = "Дата" Тогда
	//	мТипЗначенияДопРеквизита = "Дата";
	////ИначеЕсли Найти(Строка(мДополнительныйРеквизит.ТипЗначения)  = "Дата" Тогда
	//	//мТипЗначенияДопРеквизита = "Дата";
	//Иначе
	//	мТипЗначенияДопРеквизита = Неопределено;
	//КонецЕсли;
	
	
	Если мТипЗначенияДопРеквизита = Неопределено Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Указан дополнительный реквизит который данной обработкой не поддерживается, выполнение обработки невозможно '"));
		Возврат;
	КонецЕсли;
	

	Если ВариантПоискаНоменклатуры=4 и мДополнительныйРеквизит.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо указать дополнительный реквизит, на закладке (Дополнительные реквизиты) т.к. поиск номенклатуры осуществляется по значению этого реквизита '"));
		Возврат;
	КонецЕсли;
	
			
	ОчиститьСообщения();
	Состояние(НСтр("ru = 'Осуществляется сопоставление введенных данных с данными информационной базы. Пожалуйста подождите...'"),,,БиблиотекаКартинок.Информация32);
	
	Если ВидНоменклатуры.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо указать вид номенклатуры'"));
		Возврат;
	КонецЕсли;
	
	
	Если Партнер.Пустая() и НеобходимоСоздатьНоменклатуруПоставщика Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Т.к. требуется создавать номенклатуру поставщика, то обязтельно указать поставщика, для которого создается номенклатура'"));
		Возврат;
	КонецЕсли;
	
	//Возврат;
	СопоставитьДанныеТабличногоДокументаСДаннымиИБ();

	Если СписокСозданныхНоменклатур.Количество()>0 Тогда
		
		Элементы.Группа1.ТекущаяСтраница = Элементы.Результат;
	КонецЕсли;
	
	
	ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Обработка завершена'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьБазовыеЕдиницыИзмерения(Команда)
	ВыбратьЕдИзм();
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции
&НаКлиенте
Процедура УправлениеВидимостью()
	Если ВариантПоискаНоменклатуры=1 Тогда
		ЭтаФорма.Элементы.НеобходимоСоздатьНоменклатуруПоставщика.Доступность = Истина;
	Иначе
		ЭтаФорма.Элементы.НеобходимоСоздатьНоменклатуруПоставщика.Доступность = Ложь;
		НеобходимоСоздатьНоменклатуруПоставщика = Ложь;
	КонецЕсли;
	
	Если ВариантПоискаНоменклатуры=4 Тогда  /// по доп реквизиту
		ЭтаФорма.Элементы.ДополнительныйРеквизит.Видимость 	= Истина;
		ЭтаФорма.Элементы.мПредупреждение.Видимость 		= Истина;

	Иначе
		ЭтаФорма.Элементы.ДополнительныйРеквизит.Видимость 	= Ложь;
		ЭтаФорма.Элементы.мПредупреждение.Видимость 		= Ложь;

	КонецЕсли;
	
	
	
		ВидимостьПараметров = НеобходимоСоздатьНоменклатуруПоставщика ;	
	
		ЭтаФорма.Элементы.ЧтоДелаемСНайденнойНоменклатуройПоставщика.Видимость						=ВидимостьПараметров;
		ЭтаФорма.Элементы.ГруппаЗагрузкиНоменклатурыПоставщиков.Видимость							=ВидимостьПараметров;
		ЭтаФорма.Элементы.Партнер.Видимость															=ВидимостьПараметров;
		ЭтаФорма.Элементы.Производитель.Видимость													=ВидимостьПараметров;
		ЭтаФорма.Элементы.ПропускатьСозданиеНоменклатурыПоставщикаСПустымиНаименованием.Видимость	=ВидимостьПараметров;
		
		ЭтаФорма.Элементы.ПутьККаталогуИзображений.Видимость			=ЗагружаемИзображения;
		ЭтаФорма.Элементы.ЗагружаемуюКартинкуСделатьОсновной.Видимость	=ЗагружаемИзображения;
		
		ЭтаФорма.Элементы.Группа8.Видимость = ЗагружатьВесогабаритныеРазмеры;	
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьДанныеТабличногоДокументаСДаннымиИБ()
	НомерПП = 1;
	ВариантЗаполнения = "";
	СписокСозданныхНоменклатур.Очистить();
	СпрНоменклатура.Очистить();
	СпрГруппыНоменклатуры.Очистить();
	СпрПрисоединённыеФайлы.Очистить();
	СпрНоменклатураПоставщиков.Очистить();
	
	ЗаполнитьТаблицуНоменклатурыИШтрихкодов();
	ТаблицаЗагружаемыхДанных = Новый ТаблицаЗначений;
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Код");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Артикул");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Штрихкод");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Наименование");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("НаименованиеДляПечати");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("НаименованиеНоменклатурыПоставщика");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("НоменклатураСсылка");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("НоменклатураПоставщикаСсылка");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("НоваяНоменклатура");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ЗначениеДопРеквизита");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ФайлКартинки");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ТекстовоеОписание");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ГруппаНаименование");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("ГруппаСсылка");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Вес");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Объем");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Длина");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Ширина");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Высота");
	ТаблицаЗагружаемыхДанных.Колонки.Добавить("Площадь");
	НомераКолонок = Новый Соответствие;
	НомерКолонки = 1;
	
	НомераКолонок.Вставить("КолонкаКод", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаАртикул", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаШтрихкод", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаНаименование", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаНаименованиДляПечати", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаЕдиницаИзмерения", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаНаименованиеНоменклатурыПоставщика", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаЗначениеДопРеквизита", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаТекстовоеОписание", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаГруппа", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаВес", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаОбъем", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаДлина", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаШирина", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаВысота", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	НомерКолонки = НомерКолонки +1;
	НомераКолонок.Вставить("КолонкаПлощадь", "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0"));
	
	НомерСтроки = 2;
	СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
	
	Если ВариантПоискаНоменклатуры=0 Тогда /// по коду
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст);
	ИначеЕсли ВариантПоискаНоменклатуры=1 Тогда /// по артукулу
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст);
		
	ИначеЕсли ВариантПоискаНоменклатуры=2 Тогда /// по штрихкоду
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаШтрихкод")).Текст);
		
	ИначеЕсли ВариантПоискаНоменклатуры=3 Тогда /// по наименованию
		
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаНаименование")).Текст);
	ИначеЕсли ВариантПоискаНоменклатуры=4 Тогда /// по дополнительному реквизиту
		
		ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаЗначениеДопРеквизита")).Текст);
		
	КонецЕсли;
	
		
		
	
		
	ЕстьОшибкиРаспознавания = Ложь;
/// 03062020	
	Пока ЗаполненыНоменклатураКодАртикулШтрихкод Цикл
		Попытка
			Если ВариантПоискаНоменклатуры=0 Тогда /// по коду
				ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаКод")).Текст);
			ИначеЕсли ВариантПоискаНоменклатуры=1 Тогда /// по артукулу
				ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + НомераКолонок.Получить("КолонкаАртикул")).Текст);
				
