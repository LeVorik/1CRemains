КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(ФайлExcel)
	
	ВременныйТабличныйДокумент = Новый ТабличныйДокумент;
	
	Попытка 
	ВременныйТабличныйДокумент.Прочитать(ФайлExcel, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		Сообщить(НСтр("ru = 'Ошибка открытия файла Microsoft Excel '") + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	КоличествоСтрок    = ВременныйТабличныйДокумент.ВысотаТаблицы;
	КоличествоКолонок  = ВременныйТабличныйДокумент.ШиринаТаблицы;
	
	Если (Excel1Строка > КоличествоСтрок) ИЛИ (Excel1Строка  <= 0) Тогда
		СообщитьПользователю(НСтр("ru = 'Не правильно указана первая строка с данными. '"), "Excel1Строка");
		Возврат;
	Конецесли;
	
	Если (ExcelАртикул > КоличествоКолонок) ИЛИ (ExcelАртикул  <= 0) Тогда
		СообщитьПользователю(НСтр("ru = 'Не правильно указана колонка с артикулом'"), "ExcelАртикул");
		Возврат;
	Конецесли;
	
	Если (ExcelНаименование > КоличествоКолонок) ИЛИ (ExcelНаименование  <= 0) Тогда
		СообщитьПользователю(НСтр("ru = 'Не правильно указана колонка с наименованием '"), "ExcelНаименование");
		Возврат;
	Конецесли;
	
	Если (ExcelГруппа > КоличествоКолонок) ИЛИ (ExcelГруппа <= 0) Тогда
		СообщитьПользователю(НСтр("ru = 'Не правильно указана колонка с группой'"), "ExcelГруппа");
		Возврат;
	Конецесли;
	
	Результат = ОбработатьДанныеТабличногоДокумента(ВременныйТабличныйДокумент, КоличествоСтрок);
	
КонецПроцедуры

&НаСервере
Функция ОбработатьДанные(Данные, КоличествоСтрок)
	
	ИнициализироватьТабличныйДокумент();
	
	НомерСтроки = 2;
	Для НомерС=Excel1Строка По КоличествоСтрок-1 Цикл

		СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
		
		Если ExcelАртикул>0 Тогда
			Если НЕ ЗначениеЗаполнено(СокрЛП(Данные[ExcelАртикул-1][НомерС-1])) Тогда
				СообщитьПользователю(Формат(НомерС, "ЧН=0; ЧГ=0") + " - в этой строке пустой артикул! Строка пропущена.");
				Продолжить;
			КонецЕсли;
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C2").Текст = СокрЛП(Данные[ExcelАртикул-1][НомерС-1]); //"КолонкаАртикул"
		КонецЕсли;
		Если ExcelНаименование>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C4").Текст = СокрЛП(Данные[ExcelНаименование-1][НомерС-1]);//КолонкаНаименование
		КонецЕсли;
		Если ExcelНаименованиеПечати>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C6").Текст = СокрЛП(Данные[ExcelНаименованиеПечати-1][НомерС-1]);//КолонкаЕдиницаИзмерения
		КонецЕсли;
		Если ExcelЕдиница>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C5").Текст = СокрЛП(Данные[ExcelЕдиница-1][НомерС-1]);//КолонкаНаименованиДляПечати
		КонецЕсли;
		Если ExcelОписание>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C9").Текст = СокрЛП(Данные[ExcelОписание-1][НомерС-1]);//КолонкаТекстовоеОписание
		КонецЕсли;
		Если ExcelГруппа>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C10").Текст = СокрЛП(Данные[ExcelГруппа-1][НомерС-1]);//КолонкаГруппа
		КонецЕсли;
		Если ExcelЦена>0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C17").Текст = СокрЛП(Данные[ExcelЦена-1][НомерС-1]);//КолонкаГруппа
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецФункции

&НаСервере
Функция ОбработатьДанныеТабличногоДокумента(ТабличныйДокумент, КоличествоСтрок)
	
	ИнициализироватьТабличныйДокумент();
	
	НомерСтроки = 2;
	Для НомерС=Excel1Строка По КоличествоСтрок-1 Цикл

		СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
		
		Если ExcelАртикул>0 Тогда
			Если НЕ ЗначениеЗаполнено(ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelАртикул)) Тогда
				СообщитьПользователю(Формат(НомерС, "ЧН=0; ЧГ=0") + " - в этой строке пустой артикул! Строка пропущена.");
				Продолжить;
			КонецЕсли;
			//КолонкаАртикул
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C2").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelАртикул); 
		КонецЕсли;
		
		//КолонкаНаименование
		Если ExcelНаименование > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C4").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelНаименование);
		КонецЕсли;
		
		//КолонкаНаименованиеПечати
		Если ExcelНаименованиеПечати > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C5").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelНаименованиеПечати);
		КонецЕсли;
		
		//КолонкаЕдиница
		Если ExcelЕдиница > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C6").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelЕдиница);
		КонецЕсли;
		
		//КолонкаОписание
		Если ExcelОписание > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C9").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelОписание);
		КонецЕсли;
		
		//КолонкаГруппа
		Если ExcelГруппа > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C10").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelГруппа);
		КонецЕсли;
		
		//КолонкаЦена
		Если ExcelЦена > 0 Тогда
			ДанныеДляЗагрузки.Область("R" + СтроковыйНомер + "C17").Текст = ПолучитьЗначениеЯчейки(ТабличныйДокумент,НомерС,ExcelЦена);
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецФункции

&НаСервере
Функция ПолучитьЗначениеЯчейки(ТабличныйДокумент, НомерСтроки, НомерСтолбца)
	Возврат Строка(ТабличныйДокумент.ПолучитьОбласть("R" +  Формат(НомерСтроки, "ЧГ=0") + "C"+ НомерСтолбца).ТекущаяОбласть.Текст);
КонецФункции 


&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	ОчиститьСообщения();
	АдресФайлаВоВременномХранилище = "";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьДанныеЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(ОписаниеОповещения, АдресФайлаВоВременномХранилище,,,УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		
		Состояние(Нстр("ru = 'Выполняется загрузка данных. Пожалуйста, подождите...'"));
		
		Файл = Новый Файл(ФайлExcel);
		Если Не Файл.Существует() Тогда
			
			ТекстСообщения = Нстр("ru = 'Указанный файл не существует'");
			ПутьКДанным = ?(Истина, "", "ИмяФайлаЗагрузки");
			СообщитьПользователю(ТекстСообщения, ПутьКДанным);
			Возврат;
			
		КонецЕсли;
		
		ЗагрузитьДанныеНаСервере(Адрес, Файл.Расширение);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище, Расширение)

		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		
		ПрочитатьФайлНаСервере(ИмяВременногоФайла);
		
		Файл = Новый Файл(ИмяВременногоФайла);
		
		Если Файл.Существует() Тогда
			
			УдалитьФайлы(ИмяВременногоФайла);
			
		КонецЕсли;
		

КонецПроцедуры

#КонецОбласти
