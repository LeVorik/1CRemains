&НаСервере
Процедура ВыбратьЕдИзм()
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка,
		|	УпаковкиЕдиницыИзмерения.Владелец КАК Владелец,
		|	УпаковкиЕдиницыИзмерения.Родитель КАК Родитель,
		|	УпаковкиЕдиницыИзмерения.Код КАК Код,
		|	УпаковкиЕдиницыИзмерения.Наименование КАК Наименование,
		|	УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	УпаковкиЕдиницыИзмерения.НаименованиеПолное КАК НаименованиеПолное,
		|	УпаковкиЕдиницыИзмерения.МеждународноеСокращение КАК МеждународноеСокращение,
		|	УпаковкиЕдиницыИзмерения.ТипУпаковки КАК ТипУпаковки,
		|	УпаковкиЕдиницыИзмерения.Предопределенный КАК Предопределенный,
		|	УпаковкиЕдиницыИзмерения.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Владелец.Код ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить(Строка(ТипЗнч(ВыборкаДетальныеЗаписи.Владелец))+"   "+Строка(ВыборкаДетальныеЗаписи.Владелец));
	КонецЦикла;
	
	
	
	
	
КонецПроцедуры

&НаСервере
Функция ПоискБазовойЕдиницыИзмерения(СтрокаПоиска)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыУпаковок КАК НаборыУпаковок
		|		ПО УпаковкиЕдиницыИзмерения.Владелец = НаборыУпаковок.Ссылка
		|ГДЕ
		|	НаборыУпаковок.Ссылка = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
		|	И УпаковкиЕдиницыИзмерения.Код ПОДОБНО &Код";
	
	Если ВариантПоискаЕдиницыИзмерения=0 Тогда
		Запрос.УстановитьПараметр("Код",СтрокаПоиска+"%");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И УпаковкиЕдиницыИзмерения.Код ПОДОБНО &Код", "И УпаковкиЕдиницыИзмерения.Наименование ПОДОБНО &Наименование");
		Запрос.УстановитьПараметр("Наименование",СтрокаПоиска);
	КонецЕсли;
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВыбрЕдиницаИзмерения = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВыбрЕдиницаИзмерения) Тогда
	Иначе
		Если ВариантПоискаЕдиницыИзмерения=0 Тогда
			ТекстОшибки = "Единица измерения с кодом  "+Строка(СтрокаПоиска)+"  не найдена в классификаторе";
		Иначе
			ТекстОшибки = "Единица измерения с наименованием  "+Строка(СтрокаПоиска)+"  не найдена в классификаторе";
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
    Возврат ВыбрЕдиницаИзмерения;
	
КонецФункции

